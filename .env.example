# Server-side Gemini API key (never expose to client)
GEMINI_API_KEY=

# Optional server-side Gemini Live API model alias (default: gemini-3.8-live)
GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional server-side YouTube Data API v3 key for live educational video & playlist search
YOUTUBE_API_KEY=

# Port for the full-stack Express + Vite server
PORT=3000

# Optional Node environment
NODE_ENV=development
