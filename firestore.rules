rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'venkatramveni@gmail.com';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isTeacher() {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function isAuthorizedParentOf(studentUid) {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/parentLinks/$(request.auth.uid + '_' + studentUid)) &&
        get(/databases/$(database)/documents/parentLinks/$(request.auth.uid + '_' + studentUid)).data.consentGranted == true &&
        get(/databases/$(database)/documents/parentLinks/$(request.auth.uid + '_' + studentUid)).data.status == 'active';
    }

    // 3. Entity Validation Blueprints
    function isValidUserAccount(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'role', 'board', 'classLevel',
          'preferredLanguage', 'onboardingComplete', 'guardianConsentApproved',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'role', 'board', 'classLevel',
          'preferredLanguage', 'learningPreference', 'academicGoal',
          'subjects', 'guardianConsentApproved', 'onboardingComplete',
          'theme', 'studyStreak', 'voiceAutoSpeak', 'speechRate', 'speechPitch', 'voicePreset', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80 &&
        data.role in ['student', 'parent', 'teacher', 'admin'] &&
        data.board is string && data.board.size() >= 2 && data.board.size() <= 80 &&
        data.classLevel is int && data.classLevel >= 1 && data.classLevel <= 12 &&
        data.preferredLanguage is string && data.preferredLanguage.size() >= 2 && data.preferredLanguage.size() <= 40 &&
        (!('learningPreference' in data) || (data.learningPreference is string && data.learningPreference.size() <= 60)) &&
        (!('academicGoal' in data) || (data.academicGoal is string && data.academicGoal.size() <= 240)) &&
        (!('subjects' in data) || (data.subjects is list && data.subjects.size() <= 12 && (data.subjects.size() == 0 || data.subjects[0] is string))) &&
        data.guardianConsentApproved is bool &&
        data.onboardingComplete is bool &&
        (!('theme' in data) || data.theme in ['dark', 'light']) &&
        (!('studyStreak' in data) || (data.studyStreak is int && data.studyStreak >= 0 && data.studyStreak <= 5000)) &&
        (!('voiceAutoSpeak' in data) || data.voiceAutoSpeak is bool) &&
        (!('speechRate' in data) || ((data.speechRate is int || data.speechRate is float) && data.speechRate >= 0.5 && data.speechRate <= 2.0)) &&
        (!('speechPitch' in data) || ((data.speechPitch is int || data.speechPitch is float) && data.speechPitch >= 0.5 && data.speechPitch <= 2.0)) &&
        (!('voicePreset' in data) || (data.voicePreset is string && data.voicePreset in ['Sulafat', 'Kore', 'Zephyr', 'Aoede', 'Puck', 'Charon', 'Fenrir'])) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'notificationsEnabled', 'nonEssentialNotifications', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'guardianEmail', 'notificationsEnabled', 'nonEssentialNotifications', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        (!('guardianEmail' in data) || (data.guardianEmail is string && data.guardianEmail.size() <= 160)) &&
        data.notificationsEnabled is bool &&
        data.nonEssentialNotifications is bool &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRegistry(data) {
      return data.keys().hasAll(['uid', 'grantedAt']) &&
        data.keys().hasOnly(['uid', 'grantedAt']) &&
        isValidId(data.uid) &&
        data.grantedAt is timestamp;
    }

    function isValidParentLink(data) {
      return data.keys().hasAll(['parentUid', 'studentUid', 'consentGranted', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['parentUid', 'studentUid', 'studentDisplayName', 'consentGranted', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.parentUid) &&
        isValidId(data.studentUid) &&
        (!('studentDisplayName' in data) || (data.studentDisplayName is string && data.studentDisplayName.size() <= 80)) &&
        data.consentGranted is bool &&
        data.status in ['pending', 'active', 'revoked'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLesson(data) {
      return data.keys().hasAll([
          'board', 'classLevel', 'subject', 'chapter', 'topic', 'title',
          'language', 'summary', 'isSampleContent', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'board', 'classLevel', 'subject', 'chapter', 'topic', 'title',
          'language', 'summary', 'isSampleContent', 'xrModelId', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.board is string && data.board.size() >= 2 && data.board.size() <= 80 &&
        data.classLevel is int && data.classLevel >= 1 && data.classLevel <= 12 &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 60 &&
        data.chapter is string && data.chapter.size() >= 2 && data.chapter.size() <= 120 &&
        data.topic is string && data.topic.size() >= 2 && data.topic.size() <= 120 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
        data.language is string && data.language.size() >= 2 && data.language.size() <= 40 &&
        data.summary is string && data.summary.size() >= 10 && data.summary.size() <= 2000 &&
        data.isSampleContent is bool &&
        (!('xrModelId' in data) || (data.xrModelId is string && data.xrModelId.size() <= 60)) &&
        isValidId(data.createdBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidQuestion(data) {
      return data.keys().hasAll([
          'board', 'classLevel', 'subject', 'chapter', 'topic',
          'type', 'difficulty', 'prompt', 'explanation', 'createdBy', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'board', 'classLevel', 'subject', 'chapter', 'topic',
          'type', 'difficulty', 'prompt', 'options', 'explanation', 'createdBy', 'createdAt'
        ]) &&
        data.board is string && data.board.size() >= 2 && data.board.size() <= 80 &&
        data.classLevel is int && data.classLevel >= 1 && data.classLevel <= 12 &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 60 &&
        data.chapter is string && data.chapter.size() >= 2 && data.chapter.size() <= 120 &&
        data.topic is string && data.topic.size() >= 2 && data.topic.size() <= 120 &&
        data.type in ['mcq', 'true_false', 'fill_blank', 'match', 'short_answer'] &&
        data.difficulty in ['easy', 'medium', 'hard'] &&
        data.prompt is string && data.prompt.size() >= 4 && data.prompt.size() <= 600 &&
        (!('options' in data) || (data.options is list && data.options.size() <= 8 && (data.options.size() == 0 || data.options[0] is string))) &&
        data.explanation is string && data.explanation.size() >= 4 && data.explanation.size() <= 1000 &&
        isValidId(data.createdBy) &&
        data.createdAt is timestamp;
    }

    function isValidQuizAttempt(data) {
      return data.keys().hasAll(['uid', 'assessmentId', 'mode', 'subject', 'score', 'total', 'percentage', 'status', 'submittedAt']) &&
        data.keys().hasOnly(['uid', 'assessmentId', 'mode', 'subject', 'score', 'total', 'percentage', 'status', 'submittedAt']) &&
        isValidId(data.uid) &&
        isValidId(data.assessmentId) &&
        data.mode in ['daily_quiz', 'weekly_test', 'practice'] &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 60 &&
        data.score is int && data.score >= 0 && data.score <= 200 &&
        data.total is int && data.total >= 1 && data.total <= 200 &&
        data.score <= data.total &&
        (data.percentage is int || data.percentage is float) && data.percentage >= 0 && data.percentage <= 100 &&
        data.status == 'submitted' &&
        data.submittedAt is timestamp;
    }

    function isValidAssignment(data) {
      return data.keys().hasAll(['teacherUid', 'title', 'description', 'subject', 'board', 'classLevel', 'dueDate', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['teacherUid', 'title', 'description', 'subject', 'board', 'classLevel', 'dueDate', 'createdAt', 'updatedAt']) &&
        isValidId(data.teacherUid) &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 140 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 1500 &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 60 &&
        data.board is string && data.board.size() >= 2 && data.board.size() <= 80 &&
        data.classLevel is int && data.classLevel >= 1 && data.classLevel <= 12 &&
        data.dueDate is string && data.dueDate.size() >= 4 && data.dueDate.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['assignmentId', 'studentUid', 'content', 'status', 'submittedAt', 'updatedAt']) &&
        data.keys().hasOnly(['assignmentId', 'studentUid', 'content', 'status', 'teacherFeedback', 'grade', 'submittedAt', 'updatedAt']) &&
        isValidId(data.assignmentId) &&
        isValidId(data.studentUid) &&
        data.content is string && data.content.size() >= 2 && data.content.size() <= 4000 &&
        data.status in ['submitted', 'reviewed'] &&
        (!('teacherFeedback' in data) || (data.teacherFeedback is string && data.teacherFeedback.size() <= 1000)) &&
        (!('grade' in data) || (data.grade is string && data.grade.size() <= 20)) &&
        data.submittedAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLearningProgress(data) {
      return data.keys().hasAll(['uid', 'lessonId', 'subject', 'completed', 'bookmarked', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'lessonId', 'subject', 'completed', 'bookmarked', 'updatedAt']) &&
        isValidId(data.uid) &&
        isValidId(data.lessonId) &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 60 &&
        data.completed is bool &&
        data.bookmarked is bool &&
        data.updatedAt is timestamp;
    }

    function isValidStudyPlan(data) {
      return data.keys().hasAll(['uid', 'title', 'subject', 'scheduledDate', 'taskType', 'completed', 'reminderEnabled', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'title', 'subject', 'scheduledDate', 'scheduledTime', 'taskType', 'priority', 'recurrence', 'completed', 'reminderEnabled', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 60 &&
        data.scheduledDate is string && data.scheduledDate.size() >= 4 && data.scheduledDate.size() <= 30 &&
        (!('scheduledTime' in data) || (data.scheduledTime is string && data.scheduledTime.size() <= 20)) &&
        data.taskType in ['lesson', 'quiz', 'revision', 'assignment', 'exam'] &&
        (!('priority' in data) || data.priority in ['low', 'medium', 'high']) &&
        (!('recurrence' in data) || data.recurrence in ['none', 'daily', 'weekly']) &&
        data.completed is bool &&
        data.reminderEnabled is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['uid', 'title', 'message', 'category', 'read', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'title', 'message', 'category', 'read', 'createdAt']) &&
        isValidId(data.uid) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.message is string && data.message.size() >= 2 && data.message.size() <= 400 &&
        data.category in ['test', 'assignment', 'study', 'milestone', 'account'] &&
        data.read is bool &&
        data.createdAt is timestamp;
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['uid', 'title', 'mode', 'subject', 'messageCount', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'title', 'mode', 'subject', 'messageCount', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.mode is string && data.mode.size() >= 2 && data.mode.size() <= 40 &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 60 &&
        data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConversationMessage(data) {
      return data.keys().hasAll(['uid', 'sender', 'text', 'feedback', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'sender', 'text', 'feedback', 'createdAt']) &&
        isValidId(data.uid) &&
        data.sender in ['student', 'ai'] &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 6000 &&
        data.feedback in ['none', 'helpful', 'needs_clarity'] &&
        data.createdAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'action', 'targetPath', 'createdAt']) &&
        data.keys().hasOnly(['actorUid', 'action', 'targetPath', 'createdAt']) &&
        isValidId(data.actorUid) &&
        data.action is string && data.action.size() >= 2 && data.action.size() <= 80 &&
        data.targetPath is string && data.targetPath.size() >= 1 && data.targetPath.size() <= 200 &&
        data.createdAt is timestamp;
    }

    function isValidSavedNote(data) {
      return data.keys().hasAll(['uid', 'subject', 'title', 'content', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'subject', 'title', 'content', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 60 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 6000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 4. Connection check doc
    match /test/connection {
      allow get: if true;
    }

    // 5. Users & Isolated Private Info
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin() || isAuthorizedParentOf(userId));
      allow list: if isAdmin();

      // Prevent self-assigned privileged roles unless bootstrapped admin
      allow create: if isValidId(userId) && isVerifiedUser() &&
        isOwner(userId) &&
        isValidUserAccount(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().role in ['student', 'parent'] || isBootstrappedAdmin());

      allow update: if isValidId(userId) && isVerifiedUser() &&
        isValidUserAccount(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'board', 'classLevel', 'preferredLanguage',
              'learningPreference', 'academicGoal', 'subjects',
              'guardianConsentApproved', 'onboardingComplete', 'theme',
              'studyStreak', 'voiceAutoSpeak', 'speechRate', 'speechPitch', 'voicePreset', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(userId) && isVerifiedUser() && (isOwner(userId) || isAdmin());

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isValidId(userId) && isValidId(docId) && isVerifiedUser() &&
          isOwner(userId) &&
          docId == 'info' &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().uid == userId &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(docId) && isVerifiedUser() &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            (
              isOwner(userId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'email', 'guardianEmail', 'notificationsEnabled', 'nonEssentialNotifications', 'updatedAt'
              ])
            )
          );
        allow delete: if isValidId(userId) && isValidId(docId) && isVerifiedUser() && (isOwner(userId) || isAdmin());
      }
    }

    // 6. Admins Registry
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(adminId) && isAdmin() &&
        isValidAdminRegistry(incoming()) &&
        incoming().grantedAt == request.time;
      allow delete: if isValidId(adminId) && isAdmin();
    }

    // 7. Parent Links
    match /parentLinks/{linkId} {
      allow get: if isValidId(linkId) && (
        isAdmin() ||
        (isSignedIn() && (existing().parentUid == request.auth.uid || existing().studentUid == request.auth.uid))
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.parentUid == request.auth.uid ||
        resource.data.studentUid == request.auth.uid
      );
      allow create: if isValidId(linkId) && isVerifiedUser() &&
        isValidParentLink(incoming()) &&
        linkId == incoming().parentUid + '_' + incoming().studentUid &&
        exists(/databases/$(database)/documents/users/$(incoming().studentUid)) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isAdmin() || (incoming().parentUid == request.auth.uid && incoming().status == 'pending' && incoming().consentGranted == false));
      allow update: if isValidId(linkId) && isVerifiedUser() &&
        isValidParentLink(incoming()) &&
        incoming().parentUid == existing().parentUid &&
        incoming().studentUid == existing().studentUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().studentUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['consentGranted', 'status', 'updatedAt']))
        );
      allow delete: if isValidId(linkId) && isVerifiedUser() && (
        isAdmin() ||
        existing().parentUid == request.auth.uid ||
        existing().studentUid == request.auth.uid
      );
    }

    // 8. Educational Content: Lessons & Questions
    match /lessons/{lessonId} {
      allow get: if isValidId(lessonId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.board is string && resource.data.board.size() >= 2;
      allow create: if isValidId(lessonId) && isVerifiedUser() &&
        (isAdmin() || isTeacher()) &&
        isValidLesson(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(lessonId) && isVerifiedUser() &&
        (isAdmin() || (isTeacher() && existing().createdBy == request.auth.uid)) &&
        isValidLesson(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'topic', 'summary', 'language', 'xrModelId', 'updatedAt']);
      allow delete: if isValidId(lessonId) && isAdmin();
    }

    match /questions/{questionId} {
      allow get: if isValidId(questionId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.board is string && resource.data.board.size() >= 2;
      allow create: if isValidId(questionId) && isVerifiedUser() &&
        (isAdmin() || isTeacher()) &&
        isValidQuestion(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if isValidId(questionId) && isAdmin() &&
        isValidQuestion(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(questionId) && isAdmin();
    }

    // 9. Immutable Quiz & Test Attempts
    match /quizAttempts/{attemptId} {
      allow get: if isValidId(attemptId) && (
        isAdmin() ||
        isTeacher() ||
        (isSignedIn() && existing().uid == request.auth.uid) ||
        isAuthorizedParentOf(existing().uid)
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        isTeacher() ||
        resource.data.uid == request.auth.uid
      );
      allow create: if isValidId(attemptId) && isVerifiedUser() &&
        isValidQuizAttempt(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().submittedAt == request.time;
      allow update, delete: if isValidId(attemptId) && isAdmin();
    }

    // 10. Assignments & Submissions
    match /assignments/{assignmentId} {
      allow get: if isValidId(assignmentId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.board is string && resource.data.board.size() >= 2;
      allow create: if isValidId(assignmentId) && isVerifiedUser() &&
        (isAdmin() || isTeacher()) &&
        isValidAssignment(incoming()) &&
        incoming().teacherUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(assignmentId) && isVerifiedUser() &&
        isValidAssignment(incoming()) &&
        incoming().teacherUid == existing().teacherUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (isTeacher() && existing().teacherUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'dueDate', 'updatedAt']))
        );
      allow delete: if isValidId(assignmentId) && isVerifiedUser() && (isAdmin() || (isTeacher() && existing().teacherUid == request.auth.uid));
    }

    match /submissions/{submissionId} {
      allow get: if isValidId(submissionId) && (
        isAdmin() ||
        isTeacher() ||
        (isSignedIn() && existing().studentUid == request.auth.uid) ||
        isAuthorizedParentOf(existing().studentUid)
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        isTeacher() ||
        resource.data.studentUid == request.auth.uid
      );
      allow create: if isValidId(submissionId) && isVerifiedUser() &&
        isValidSubmission(incoming()) &&
        incoming().studentUid == request.auth.uid &&
        incoming().status == 'submitted' &&
        exists(/databases/$(database)/documents/assignments/$(incoming().assignmentId)) &&
        incoming().submittedAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(submissionId) && isVerifiedUser() &&
        isValidSubmission(incoming()) &&
        incoming().assignmentId == existing().assignmentId &&
        incoming().studentUid == existing().studentUid &&
        incoming().submittedAt == existing().submittedAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (isTeacher() && incoming().status == 'reviewed' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'teacherFeedback', 'grade', 'updatedAt'])) ||
          (existing().studentUid == request.auth.uid && existing().status != 'reviewed' && incoming().status == 'submitted' && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'updatedAt']))
        );
      allow delete: if isValidId(submissionId) && isAdmin();
    }

    // 11. Learning Progress & Study Plans
    match /learningProgress/{progressId} {
      allow get: if isValidId(progressId) && (
        isAdmin() ||
        (isSignedIn() && existing().uid == request.auth.uid) ||
        isAuthorizedParentOf(existing().uid)
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.uid == request.auth.uid
      );
      allow create: if isValidId(progressId) && isVerifiedUser() &&
        isValidLearningProgress(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(progressId) && isVerifiedUser() &&
        isValidLearningProgress(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().lessonId == existing().lessonId &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().uid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'bookmarked', 'updatedAt']))
        );
      allow delete: if isValidId(progressId) && isVerifiedUser() && (isAdmin() || existing().uid == request.auth.uid);
    }

    match /studyPlans/{planId} {
      allow get: if isValidId(planId) && (
        isAdmin() ||
        (isSignedIn() && existing().uid == request.auth.uid) ||
        isAuthorizedParentOf(existing().uid)
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.uid == request.auth.uid
      );
      allow create: if isValidId(planId) && isVerifiedUser() &&
        isValidStudyPlan(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(planId) && isVerifiedUser() &&
        isValidStudyPlan(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().uid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subject', 'scheduledDate', 'scheduledTime', 'taskType', 'priority', 'recurrence', 'completed', 'reminderEnabled', 'updatedAt']))
        );
      allow delete: if isValidId(planId) && isVerifiedUser() && (isAdmin() || existing().uid == request.auth.uid);
    }

    // 12. Notifications
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && (isAdmin() || (isSignedIn() && existing().uid == request.auth.uid));
      allow list: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isValidId(notificationId) && isVerifiedUser() &&
        isValidNotification(incoming()) &&
        (isAdmin() || incoming().uid == request.auth.uid) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(notificationId) && isVerifiedUser() &&
        isValidNotification(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (existing().uid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']))
        );
      allow delete: if isValidId(notificationId) && isVerifiedUser() && (isAdmin() || existing().uid == request.auth.uid);
    }

    // 13. AI Teacher Conversations & Messages (Master Gate)
    match /conversations/{conversationId} {
      allow get: if isValidId(conversationId) && (isAdmin() || (isSignedIn() && existing().uid == request.auth.uid));
      allow list: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isValidId(conversationId) && isVerifiedUser() &&
        isValidConversation(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(conversationId) && isVerifiedUser() &&
        isValidConversation(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().uid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'mode', 'messageCount', 'updatedAt']))
        );
      allow delete: if isValidId(conversationId) && isVerifiedUser() && (isAdmin() || existing().uid == request.auth.uid);

      match /messages/{messageId} {
        allow get: if isValidId(conversationId) && isValidId(messageId) && (
          isAdmin() ||
          (isSignedIn() && get(/databases/$(database)/documents/conversations/$(conversationId)).data.uid == request.auth.uid)
        );
        allow list: if isValidId(conversationId) && isSignedIn() && (
          isAdmin() ||
          resource.data.uid == request.auth.uid
        );
        allow create: if isValidId(conversationId) && isValidId(messageId) && isVerifiedUser() &&
          isValidConversationMessage(incoming()) &&
          incoming().uid == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.uid == request.auth.uid;
        allow update: if isValidId(conversationId) && isValidId(messageId) && isVerifiedUser() &&
          isValidConversationMessage(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().sender == existing().sender &&
          incoming().text == existing().text &&
          incoming().createdAt == existing().createdAt && (
            isAdmin() ||
            (get(/databases/$(database)/documents/conversations/$(conversationId)).data.uid == request.auth.uid &&
             incoming().diff(existing()).affectedKeys().hasOnly(['feedback']))
          );
        allow delete: if isValidId(conversationId) && isValidId(messageId) && isVerifiedUser() && (
          isAdmin() ||
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.uid == request.auth.uid
        );
      }
    }

    // 14. Immutable Audit Logs
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(logId) && isVerifiedUser() &&
        isValidAuditLog(incoming()) &&
        incoming().actorUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // 15. Personal Saved Notes (Owner-only)
    match /savedNotes/{noteId} {
      allow get: if isValidId(noteId) && (isAdmin() || (isSignedIn() && existing().uid == request.auth.uid));
      allow list: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isValidId(noteId) && isVerifiedUser() &&
        isValidSavedNote(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(noteId) && isVerifiedUser() &&
        isValidSavedNote(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().uid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['subject', 'title', 'content', 'updatedAt']))
        );
      allow delete: if isValidId(noteId) && isVerifiedUser() && (isAdmin() || existing().uid == request.auth.uid);
    }
  }
}
